!/storage/telegram-pending/.gitkeep
/storage/bot-worker.pid
/storage/*.pid

# Public generated
/public/qrcodes/*
!/public/qrcodes/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs & caches
*.log
npm-debug.log*
.cache/

# Local tooling
.grok-changes

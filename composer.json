{
  "name": "autowin/php",
  "description": "AutoWin — sistema completo de bots Blaze/Jonbet em PHP + MySQL",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "minishlink/web-push": "^10.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8000 -t public public/router-dev.php",
    "bot": "php bot/worker.php",
    "migrate": "php database/migrate.php"
  }
}

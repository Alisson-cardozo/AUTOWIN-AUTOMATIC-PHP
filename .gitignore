# Dependencies
/vendor/
/node_modules/

# Secrets & env
.env
.env.local
.env.*.local

# Runtime / sessions (por usuário — não versionar)
/storage/logs/*
!/storage/logs/.gitkeep
/storage/bacbo-evo/*
!/storage/bacbo-evo/.gitkeep

APP_NAME=AutoWin
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET=change-me-to-a-long-random-string
BOT_SECRET=change-me-bot-internal-secret
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autowin
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=autowin_session
USER_COOKIE=user_session
ADMIN_COOKIE=admin_session

# Anti-captcha (Blaze + Jonbet login) — igual ao auto-autowin
ANTI_CAPTCHA_API_KEY=
TURNSTILE_SITE_KEY=0x4AAAAAABNpvJayiqOm2i7m
JONBET_TURNSTILE_SITE_KEY=0x4AAAAAABOYk0pSWlbHhm-u
HCAPTCHA_SERVICE_URL=
HCAPTCHA_SITE_KEY=

# Opcional — também configurável no Admin
# MERCADOPAGO_ACCESS_TOKEN=
# TRIAL_HOURS=1

# Proxy residencial para Bac Bo REAL (entry + WebSocket na Evolution) —
# necessário em servidor/VPS pois a Evolution bloqueia IP de datacenter (Akamai).
# Formato: http://usuario:senha@host:porta  ou  socks5://usuario:senha@host:porta
# BACBO_PROXY_URL=

# AutoWin — document root = pasta public/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Arquivos e pastas reais (assets, imagens, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
